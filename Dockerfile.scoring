# Hosted scoring image (Render): MLflow serves model/champion. Swap the model by changing that folder.
FROM python:3.11-slim

WORKDIR /usr/src/app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    MLFLOW_TRACKING_URI=file:///tmp/mlruns

COPY requirements-scoring.txt .
RUN pip install --no-cache-dir -r requirements-scoring.txt

COPY model/champion ./model/champion

RUN useradd --system --no-create-home appuser
USER appuser

EXPOSE 5001
CMD ["sh", "-c", "mlflow models serve -m model/champion --host 0.0.0.0 --port ${PORT:-5001} --env-manager local"]
