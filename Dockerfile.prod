# Hosted API image (Render): FastAPI only, non-root. Scoring lives in Dockerfile.scoring.
FROM python:3.11-slim

WORKDIR /usr/src/app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_VERSION=champion-v1

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY main.py .
COPY app ./app

RUN useradd --system --no-create-home appuser && chown -R appuser /usr/src/app
USER appuser

EXPOSE 8000
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
